{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "instrumentistas/score/v1",
  "title": "Instrumentistas Score Schema v1",
  "description": "Schema do protocolo CXD+T90. Cada acorde carrega o bloco 'protocol' (gerado automaticamente), o bloco 'human' (preenchido pelo editor) e o bloco 'ground_truth' (calculado no salvamento).",

  "type": "object",
  "required": ["schema_version", "title", "composer", "key", "key_sig", "bpm", "meter", "clef", "sections"],

  "properties": {

    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Versão do schema. Incrementar quando houver breaking change."
    },

    "title":    { "type": "string" },
    "composer": { "type": "string" },
    "key":      { "type": "string", "examples": ["Cm", "G", "Bb"] },
    "key_sig":  { "type": "integer", "minimum": -7, "maximum": 7,
                  "description": "Negativo = bemóis, positivo = sustenidos, 0 = Dó maior." },
    "bpm":      { "type": "string", "examples": ["75-85", "120"] },
    "meter":    { "type": "string", "examples": ["4/4", "3/4", "6/8"] },
    "clef":     { "type": "string", "enum": ["treble", "bass"] },

    "pipeline_version": {
      "type": "string",
      "description": "Versão do pipeline que gerou este arquivo.",
      "examples": ["v5"]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },

    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    }
  },

  "$defs": {

    "section": {
      "type": "object",
      "required": ["id", "label", "lines"],
      "properties": {
        "id":    { "type": "string", "examples": ["verso_1", "refrao", "intro"] },
        "label": { "type": "string" },
        "lines": {
          "type": "array",
          "items": { "$ref": "#/$defs/line" }
        }
      }
    },

    "line": {
      "type": "object",
      "required": ["id", "measures"],
      "properties": {
        "id":       { "type": "string" },
        "measures": {
          "type": "array",
          "items": { "$ref": "#/$defs/measure" }
        }
      }
    },

    "measure": {
      "type": "object",
      "required": ["n", "x0", "x1", "chords", "notes", "syllables"],
      "properties": {
        "n":          { "type": "integer", "description": "Número do compasso na linha." },
        "x0":         { "type": "number",  "description": "Borda esquerda em px." },
        "x1":         { "type": "number",  "description": "Borda direita em px." },
        "beats_used": { "type": "number",  "description": "Soma de duração das notas detectadas." },
        "chords":     { "type": "array", "items": { "$ref": "#/$defs/chord_entry" } },
        "notes":      { "type": "array", "items": { "$ref": "#/$defs/note_entry"  } },
        "syllables":  { "type": "array", "items": { "$ref": "#/$defs/syllable_entry" } }
      }
    },

    "chord_entry": {
      "type": "object",
      "required": ["symbol", "beat", "beat_ratio", "protocol"],
      "properties": {

        "symbol": {
          "type": "string",
          "description": "Símbolo do acorde normalizado.",
          "examples": ["Cm", "G7", "Bb", "Fm", "Ab"]
        },

        "beat": {
          "type": "integer", "minimum": 1,
          "description": "Tempo do compasso onde o acorde entra."
        },

        "beat_ratio": {
          "type": "number", "minimum": 0, "maximum": 1,
          "description": "Posição relativa dentro do compasso (0=início, 1=fim)."
        },

        "protocol": {
          "description": "O que o pipeline CXD+T90 decidiu. IMUTÁVEL após geração.",
          "type": "object",
          "required": ["cx", "rule"],
          "properties": {
            "cx": {
              "type": "number",
              "description": "Posição horizontal do acorde em px no PDF original."
            },
            "rule": {
              "type": "string",
              "enum": ["T90", "T90.2_MELISMA", "T90.3_PAUSA", "V90", "VAZIO"],
              "description": "Regra que resolveu este acorde."
            },
            "syllable": {
              "type": ["string", "null"],
              "description": "Sílaba âncora encontrada pelo protocolo. null = não encontrada."
            },
            "syllable_cx": {
              "type": ["number", "null"],
              "description": "Posição da sílaba âncora em px."
            },
            "float_cx": {
              "type": ["number", "null"],
              "description": "Posição flutuante (T90.3/VAZIO): acorde sem sílaba âncora."
            },
            "next_syllable": {
              "type": ["string", "null"],
              "description": "Próxima sílaba após o acorde flutuante (referência de display)."
            },
            "nota_anchor": {
              "type": ["string", "null"],
              "description": "Char e cx da nota âncora usada pelo T90. Ex: 'œ@220'."
            }
          }
        },

        "human": {
          "description": "O que o editor humano decidiu. Preenchido ao salvar no editor.",
          "type": ["object", "null"],
          "properties": {
            "syllable": {
              "type": ["string", "null"],
              "description": "Sílaba que o humano associou ao acorde."
            },
            "syllable_cx": {
              "type": ["number", "null"],
              "description": "Posição da sílaba escolhida pelo humano em px."
            },
            "cx_display": {
              "type": ["number", "null"],
              "description": "Posição final do acorde no editor após drag (px)."
            },
            "validated_by": {
              "type": "string",
              "description": "Nome de quem validou."
            },
            "validated_at": {
              "type": "string",
              "format": "date-time"
            },
            "note": {
              "type": "string",
              "description": "Observação livre do validador sobre este acorde."
            }
          }
        },

        "ground_truth": {
          "description": "Calculado automaticamente no momento do salvamento. Nunca editado manualmente.",
          "type": ["object", "null"],
          "required": ["status"],
          "properties": {

            "status": {
              "type": "string",
              "enum": [
                "correct",
                "corrected",
                "unvalidated"
              ],
              "description": "correct = protocolo acertou | corrected = humano corrigiu | unvalidated = ainda não revisado"
            },

            "correct": {
              "type": ["boolean", "null"],
              "description": "true se protocol.syllable == human.syllable."
            },

            "delta_cx": {
              "type": ["number", "null"],
              "description": "Distância em px entre cx do protocolo e cx do humano. null se VAZIO."
            },

            "correction_type": {
              "type": ["string", "null"],
              "enum": [
                "anchor_shift",
                "wrong_syllable",
                "missing_chord",
                "extra_chord",
                "beat_wrong",
                "melisma_undetected",
                "pause_undetected",
                "correct",
                null
              ],
              "description": "Classificação automática do tipo de correção aplicada."
            },

            "rule_changed": {
              "type": ["boolean", "null"],
              "description": "true se a regra implícita na correção humana difere da regra do protocolo."
            },

            "implied_rule": {
              "type": ["string", "null"],
              "enum": ["T90", "T90.2_MELISMA", "T90.3_PAUSA", "V90", "VAZIO", null],
              "description": "Regra que a correção humana implica — inferida pelo sistema no salvamento."
            }
          }
        }
      }
    },

    "note_entry": {
      "type": "object",
      "required": ["cx", "figure", "beats", "is_rest"],
      "properties": {
        "cx":      { "type": "number" },
        "note":    { "type": ["string", "null"], "description": "Nome da nota. Ex: 'Sib4'." },
        "midi":    { "type": ["integer", "null"], "minimum": 0, "maximum": 127 },
        "figure":  { "type": "string",
                     "enum": ["semibreve","mínima","semínima","colcheia",
                              "semicolcheia","fusa",
                              "pausa_semibreve","pausa_mínima","pausa_semínima","pausa_colcheia"] },
        "beats":   { "type": "number", "minimum": 0 },
        "is_rest": { "type": "boolean" },
        "flags":   { "type": "integer", "minimum": 0,
                     "description": "Número de bandeiras: 0=semínima, 1=colcheia, 2=semicolcheia." }
      }
    },

    "syllable_entry": {
      "type": "object",
      "required": ["text", "cx"],
      "properties": {
        "text":      { "type": "string" },
        "cx":        { "type": "number" },
        "anacrusis": { "type": "boolean",
                       "description": "true se esta sílaba pertence a um compasso anacrusis (levare)." }
      }
    }

  }
}
